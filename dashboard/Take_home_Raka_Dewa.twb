      <column caption='Retail Price' datatype='real' default-format='C1033%' name='[Calculation_0945097629687808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF NOT ISNULL([sold_at]) THEN [product_retail_price] END)' />
      </column>
      <column caption='Profit' datatype='real' default-format='C1033%' name='[Calculation_1175170624421888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[product_retail_price] - [cost]' />
      </column>
      <column caption='Profit Terjual' datatype='real' default-format='C1033%' name='[Calculation_1175170624892929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF NOT ISNULL([sold_at]) THEN [Calculation_1175170624421888] END)' />
      </column>
      <column caption='Persentase Sold' datatype='real' default-format='p0.00%' name='[Calculation_1175170694402050]' role='measure' type='quantitative'>
